# Neon Postgres - pooled connection for the app, direct for migrations
DATABASE_URL="postgresql://user:password@ep-example-pooler.neon.tech/thread?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example.neon.tech/thread?sslmode=require"

# Auth - session cookie is a signed JWT (see lib/auth/session.ts).
# Generate a strong secret with: openssl rand -base64 32
AUTH_SECRET=""

# AI (Gemini) - provider-agnostic service layer reads this, see lib/ai
GEMINI_API_KEY=""

# Keep-alive pings (see .github/workflows/keep-alive.yml, docs/Deployment.md)
# Bearer token required by GET /api/health/db so it can't be hit publicly.
# Generate with: openssl rand -base64 32
CRON_SECRET=""